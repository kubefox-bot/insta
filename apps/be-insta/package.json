    "@nestjs/swagger": "12.0.2",
    "busboy": "1.6.0",
    "jose": "6.2.12",
    "mediabunny": "1.61.3",
    "mongodb": "7.7.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.0.16",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
