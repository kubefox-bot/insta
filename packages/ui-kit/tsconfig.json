{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["svelte", "vite/client", "bun"],
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "__tests__/**/*.ts",
    "__tests__/**/*.svelte",
    "../fe-core/src/ui/**/*.ts",
    "../fe-core/src/ui/**/*.svelte"
  ]
}
