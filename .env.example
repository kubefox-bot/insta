# bun run infra:up generates random local credentials in ignored .env.
# Do not paste production secrets into this workspace.
# Stories default to enabled; infra:prepare generates storage credentials/profile.
# Set STORIES_MODE=disabled only for an explicit Core-only app run.
MONGO_ROOT_PASSWORD=
API_MONGO_PASSWORD=
WEB_MONGO_PASSWORD=
DRAGONFLY_PASSWORD=
DELIVERY_DRAGONFLY_PASSWORD=
# Backend/testhost require DELIVERY_DRAGONFLY_URL; Compose derives it from the dedicated password.
AUTH_SIGNING_KEY=
SESSION_ENCRYPTION_KEY=
BFF_SOURCE_SIGNING_KEY=
STORIES_MODE=enabled
STORIES_ACCESS_KEY=
STORIES_SECRET_KEY=
STORIES_ACTIVE_PROFILE=local-v1
# Generated as one JSON profile by infra:prepare; never commit its credential values.
STORIES_STORAGE_PROFILES=
# Optional explicit known proxy hostname; no forwarded trust when absent.
# TRUSTED_WEB_PROXY_HOST=traefik
# Optional override: local Docker Engine endpoint. By default, the selected Docker CLI context is used.
# DOCKER_HOST=unix:///var/run/docker.sock
# DOCKER_HOST=npipe:////./pipe/docker_engine
# COMPOSE_PROJECT_NAME=insta-core
# MAILPIT_PORT=18025
# Optional local receiver profile; empty means disabled.
FARO_RECEIVER_URL=
OTEL_RECEIVER_URL=
# Backend-only Stories policy, enabled profile only; 201..15000 ms.
STORIES_MAX_DURATION_MS=15000
# Positive integer milliseconds; affects new publications only.
STORIES_LIFETIME_MS=86400000
